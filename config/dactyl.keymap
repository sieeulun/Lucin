#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

&lt { tapping-term-ms = <300>; };

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        boot {
            bindings = <&bootloader>;
            key-positions = <33 32 30>;
        };

        boot2 {
            bindings = <&bootloader>;
            key-positions = <30 32 33>;
        };

        Numpad {
            bindings = <&tog 3>;
            key-positions = <54 66>;
        };

        LWin {
            bindings = <&kp LWIN>;
            key-positions = <50 51>;
        };

        RWin {
            bindings = <&kp RWIN>;
            key-positions = <58 59>;
        };

        PairBT {
            bindings = <&bt BT_DISC 0>;
            key-positions = <42 54 66>;
        };

        MainBT {
            bindings = <&bt BT_SEL 0>;
            key-positions = <1 42>;
        };

        BT1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <2 42>;
        };

        BT2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <3 42>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        SIXDOO {
            display-name = "Default Layer";
            bindings = <
&kp ESCAPE      &kp N1        &kp N2            &kp N3             &kp N4           &kp N5                                        &kp N6         &kp N7     &kp N8      &kp N9           &kp N0    &kp MINUS
&kp TAB         &kp Q         &kp W             &kp E              &kp R            &kp T                                         &kp Y          &kp U      &kp I       &kp O            &kp P     &kp EQUAL
&kp LEFT_SHIFT  &kp A         &kp S             &kp D              &kp F            &kp G                                         &kp H          &kp J      &kp K       &kp L            &kp SEMI  &kp SQT
&kp LCTRL       &kp Z         &kp X             &kp C              &kp V            &kp B             &mkp MB3  &kp C_PLAY_PAUSE  &kp N          &kp M      &kp COMMA   &kp DOT          &kp FSLH  &kp BSLH
                              &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SPACE        &kp LALT          &mo 2     &kp DELETE        &kp BACKSPACE  &kp ENTER  &kp K_MENU  &kp RIGHT_SHIFT
&mmv MOVE_LEFT  &mmv MOVE_UP  &mkp LCLK         &mmv MOVE_DOWN     &mmv MOVE_RIGHT  &kp LEFT_CONTROL  &mo 1     &kp ESC           &kp RCTRL      &kp LEFT   &kp DOWN    &kp RET          &kp UP    &kp RIGHT
            >;

            sensor-bindings =
                <&Scroll_D_U>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;

            label = "2THM8N";
        };

        Functions {
            display-name = "Lower Layer";
            bindings = <
&kp GRAVE      &kp F1           &kp F2            &kp F3             &kp F4            &trans                            &trans  &kp INS         &kp HOME        &kp PAGE_UP      &trans  &kp HOME
&trans         &kp F5           &kp F6            &kp F7             &kp F8            &trans                            &trans  &kp DEL         &kp END         &kp PAGE_DOWN    &trans  &kp PAGE_UP
&kp CAPSLOCK   &kp F9           &kp F10           &kp F11            &kp F12           &trans                            &trans  &none           &kp UP_ARROW    &none            &trans  &kp PAGE_DOWN
&trans         &kp PRINTSCREEN  &kp SCROLLLOCK    &kp PAUSE_BREAK    &none             &trans  &kp LC(NUMBER_0)  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &kp END
                                &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans            &trans  &trans            &trans  &trans  &trans          &none           &none
&kp C_AC_BACK  &kp C_AC_UNDO    &kp C_AC_REFRESH  &kp C_AC_REDO      &kp C_AC_FORWARD  &trans  &trans            &trans  &trans  &trans          &trans          &trans           &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>,
                <&inc_dec_kp RIGHT LEFT>;

            label = "Func";
        };

        LazyAlps {
            display-name = "LazyAlps";
            bindings = <
&kp MINUS  &kp N0                &kp N9     &kp N8                 &kp N7         &kp N6                              &trans  &trans  &trans  &trans  &trans  &trans
&kp EQUAL  &kp P                 &kp O      &kp I                  &kp U          &kp Y                               &trans  &trans  &trans  &trans  &trans  &trans
&kp APOS   &kp SEMI              &kp L      &kp K                  &kp J          &kp H                               &trans  &trans  &trans  &trans  &trans  &trans
&kp BSLH   &kp FSLH              &kp DOT    &kp COMMA              &kp M          &kp N     &kp C_PLAY_PAUSE  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                 &kp RSHFT  &kp RGUI               &kp ENTER      &kp BSPC  &trans            &trans  &trans  &trans  &trans  &trans
&kp LC(Z)  &kp LC(LEFT_BRACKET)  &kp B      &kp LC(RIGHT_BRACKET)  &kp LC(LS(Z))  &trans    &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_BRACKET RIGHT_BRACKET>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;

            label = "LazyAlps";
        };

        Numpad {
            bindings = <
&kp HOME       &kp C_MENU_ESC   &kp KP_DIVIDE    &kp KP_ASTERISK  &kp KP_MINUS  &trans                  &trans  &kp ESCAPE       &kp KP_SLASH     &kp KP_ASTERISK  &kp KP_MINUS  &kp HOME
&kp PAGE_UP    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS   &trans                  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS   &kp PAGE_UP
&kp PAGE_DOWN  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans        &trans                  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans        &kp PAGE_DOWN
&kp END        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans        &trans  &trans  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans        &kp END
                                &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_EQUAL  &trans  &trans  &trans  &trans  &kp KP_ENTER     &kp KP_NUMBER_0  &kp KP_DOT
&trans         &trans           &trans           &trans           &trans        &trans  &trans  &trans  &trans  &trans           &trans           &trans           &trans        &trans
            >;

            sensor-bindings =
                <&Scroll_D_U>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;

            label = "Numpad";
        };
    };
};
